#!/usr/bin/env bash

declare -A COLOR
COLOR['END']='\033[0m'
COLOR['RED']='\033[0;91m'
COLOR['GREEN']='\033[0;92m'
COLOR['YELLOW']='\033[0;93m'
COLOR['BLUE']='\033[0;94m'
COLOR['WHITE']='\033[0;37m'
COLOR['NC']='\033[0m'
COLOR['CYAN']='\033[0;96m'

envsDefault=1
iterDefault=100

printc() {
  local color="$1"
  shift
  echo -e "${COLOR[$color]}$@${COLOR['END']}"
}

is_number() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

cleanup() {
  echo -e "${COLOR['WHITE']}\nCleanup ${COLOR['END']}"
  sudo snap remove --purge envtester
}

get_word() {
  # echo $(curl -s https://random-word-api.herokuapp.com/word | jq -r '.[0]')
  echo $(curl -s https://random-word-api.vercel.app/api?words=1 | jq -r '.[0]')
}

help() {
  echo "Usage: $0 [-n <int>] [-i <int>]" 1>&2;
  echo -e "  -n\tMax number of environment variables to test with (default: $envsDefault)" 1>&2
  echo -e "  -i\tNumber of iterations on each config set of envs (default: $iterDefault)" 1>&2
  exit 1;
}

}

main() {
  if [ -z "${envs}" ]; then
    envs=${envsDefault}
  fi
  if [ -z "${iter}" ]; then
    iter=${iterDefault}
  fi

  envSetups=${1:-"${envs}"}

  echo -e "${COLOR['BLUE']} number of env variables: ${envs} ${COLOR['END']}"
  echo -e "${COLOR['BLUE']} number of iterations: ${iter} ${COLOR['END']}"

  cleanup
  if [ ! -f "./envtester_demo_amd64.snap" ]; then
    SNAPCRAFT_ENABLE_EXPERIMENTAL_EXTENSIONS=1 snapcraft
  fi

  echo -e "${COLOR['WHITE']}\nInstalling snap with two apps, one with and other without the exporter${COLOR['END']}"
  sudo snap install ./envtester_demo_amd64.snap --dangerous

  echo -e "${COLOR['WHITE']}\nWithout the exporter program ${COLOR['END']}"
  sudo perf stat -r${iter} envtester.default-app

  for index in $(seq 0 "$envSetups"); do
    echo "With $index environment variables"

    echo -e "${COLOR['BLUE']}\nWith ${COLOR['RED']}$index${COLOR['BLUE']} environment variables ${COLOR['END']}"
    sudo perf stat -r${iter} envtester.myapp1

    key=$(get_word)
    value=$(get_word)

    echo -e "${COLOR['WHITE']}\nSetting snap option: ${COLOR['BLUE']}$key${COLOR['WHITE']} = ${COLOR['BLUE']}$value${COLOR['END']}"
    sudo snap set envtester "env.$key"="$value"
  done

  cleanup
}

while getopts ":i:n:" o; do
    case "${o}" in
        i)
            is_number ${OPTARG} || help
            iter=${OPTARG}
            ;;
        n)
            is_number ${OPTARG} || help
            envs=${OPTARG}
            ;;
        *)
            help
            ;;
    esac
done
shift $((OPTIND-1))

set -xe
main
